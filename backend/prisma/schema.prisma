// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Test {
  id Int @id @default(autoincrement())
  content String @db.VarChar(10)
}
//enums

enum UserLocale {
  en
  es
  uk
}

enum UserRole {
  user
  admin
  moderator
}

enum OutreachTargetStatus {
  active
  do_not_contact
}

enum OutreachEventType {
  first
  repeat
  reply
  publication
  status
}

enum OutreachTemplateStatus {
  active
  archived
}

enum OutreachPublicationKind {
  post
  ad
  article
  link_in_offer
}

enum ProductCategory {
  development
  writing
  design
  productivity
  education
  business
  marketing
  finance
  research
  analytics
  communication
  automation
  imageGeneration
  videoGeneration
  audio
  translation
  socialMedia
  sales
  legal
  cybersecurity
  dataScience
  lifestyle
}

// Продукт і агент це один тип: kind лише вирішує, в якому блоці сайту його показати.
enum ProductKind {
  product
  agent
}

enum ProductStatus {
  production
  active
  beta
  build
}

enum ProductCurrency {
  USD
  EUR
  GBP
  CAD
  AUD
  JPY
  CHF
  CNY
  UAH
}

enum ProductBillingPeriod {
  week
  month
  year
}

//models

model User {
  id String @id @default(uuid())

  email String @unique
  name String @db.VarChar(50)

  role UserRole @default(user)
  // Мова кабінету й листів; обирається в кабінеті або береться з мови сайту при реєстрації.
  locale UserLocale @default(en)

  createdAt DateTime @default(now())
  deactivatedAt DateTime?

  credentials UserCredentials?
  sessions UserSession[]
  savedProducts SavedProduct[]
  library UserLibrary[]
  articles Article[]
  mediaAssets MediaAsset[]
  memberships ProductMembership[] @relation("MembershipUser")
  ownedTargets OutreachTarget[]
  outreachTemplates OutreachTemplate[]
  outreachEvents OutreachEvent[]
  grantedMemberships ProductMembership[] @relation("MembershipGrantedBy")
  revokedMemberships ProductMembership[] @relation("MembershipRevokedBy")
  auditActions AuditEvent[] @relation("AuditActor")
  auditTargets AuditEvent[] @relation("AuditTarget")

  @@unique([createdAt,id])
}

model UserCredentials {
  id String @id @default(uuid())

  userId String @unique
  passwordHash String
  passwordUpdatedAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id])
}

model UserSession {
  id String @id @default(uuid())

  userId String

  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id String @id @default(uuid())

  sessionId String

  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  session UserSession @relation(fields: [sessionId], references: [id])
}

model Product {
  id String @id @default(uuid())

  // Звʼязок зі Stripe 1 до 1: один продукт, один Stripe-продукт, одна актуальна ціна.
  stripeProductId String? @unique
  stripePriceId String? @unique

  slug String @unique
  name String
  shortDescription String @db.VarChar(160)
  description String
  categories ProductCategory[]
  features String[]

  kind ProductKind @default(product)
  status ProductStatus @default(active)
  categoryLabel String?
  tagline String?
  highlights String[]
  capabilities Json @default("[]")
  architecture Json?
  protocols String[]
  demoUrl String?
  sortOrder Int @default(0)

  // Переклади контенту: { es: {...}, uk: {...} }. Англійська лишається в колонках вище.
  translations Json @default("{}")

  // Ціна є завжди (вона йде в Stripe); showPrice лише вирішує, чи показувати її на сторінці,
  // чи користувач побачить її тільки на оплаті.
  price Decimal
  currency ProductCurrency
  billingPeriod ProductBillingPeriod
  showPrice Boolean @default(true)

  // Видалення це архівування: історія, журнал і Stripe-привʼязка не втрачаються.
  archivedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  savedBy SavedProduct[]
  availableTo UserLibrary[] 
  memberships ProductMembership[]
  outreachTargets OutreachTarget[]
  outreachIdentifiers OutreachIdentifier[]
  outreachEvents OutreachEvent[]
  outreachTemplates OutreachTemplate[]

  @@unique([createdAt, id])
  @@index([kind, archivedAt, sortOrder])
}

model SavedProduct {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([createdAt, id])
  @@index([userId])
  @@index([productId])
}

model UserLibrary {
  id String @id @default(uuid())

  userId String 
  productId String
  subscriptionId String?
  stripeSubscriptionId String?

  accessExpiresAt DateTime?
  canceledAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stripeSubscriptionId])
  @@unique([subscriptionId])
}

// Робочий доступ модератора до продукту (журнал звернень).
// Активним вважається запис з revokedAt = null; унікальність активної пари
// (userId, productId) забезпечує частковий індекс у міграції.
model ProductMembership {
  id String @id @default(uuid())

  userId String
  productId String

  grantedById String
  grantedAt DateTime @default(now())
  revokedById String?
  revokedAt DateTime?

  user User @relation("MembershipUser", fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  grantedBy User @relation("MembershipGrantedBy", fields: [grantedById], references: [id])
  revokedBy User? @relation("MembershipRevokedBy", fields: [revokedById], references: [id])

  @@index([userId])
  @@index([productId])
}

// Журнал дій адміністраторів. Секрети (паролі, токени) сюди не потрапляють.
model AuditEvent {
  id String @id @default(uuid())

  actorUserId String
  action String
  targetUserId String?
  productId String?
  meta Json?

  createdAt DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorUserId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

// Журнал звернень. Ціль (людина, компанія, сайт) належить одному продукту й одному
// власнику; власника змінює лише адмін через передачу цілей.
model OutreachTarget {
  id String @id @default(uuid())

  productId String
  displayName String
  ownerUserId String

  status OutreachTargetStatus @default(active)
  statusReason String?

  firstContactedAt DateTime?
  lastContactedAt DateTime?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  owner User @relation(fields: [ownerUserId], references: [id])
  identifiers OutreachIdentifier[]
  events OutreachEvent[]

  @@index([ownerUserId, lastContactedAt])
  @@index([productId, lastContactedAt])
}

// Одна ціль може мати кілька ідентифікаторів (Telegram, e-mail, сайт). Унікальність у межах
// продукту не дає двом модераторам зайняти те саме.
model OutreachIdentifier {
  id String @id @default(uuid())

  targetId String
  productId String
  channel String
  valueNormalized String
  createdAt DateTime @default(now())

  target OutreachTarget @relation(fields: [targetId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, channel, valueNormalized])
  @@index([targetId])
}

// Лише дописування. Вміст повідомлень не зберігається, лише факт, канал і посилання-доказ.
model OutreachEvent {
  id String @id @default(uuid())

  productId String
  targetId String?
  userId String

  type OutreachEventType
  channel String?
  url String?
  // Лише для публікацій: нормалізований URL, за яким вони не дублюються в межах продукту.
  urlNormalized String?
  publicationKind OutreachPublicationKind?
  // Який шаблон використано й у якій версії: сам текст версії не зберігається.
  templateId String?
  templateVersion Int?
  comment String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  target OutreachTarget? @relation(fields: [targetId], references: [id])
  user User @relation(fields: [userId], references: [id])
  template OutreachTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([targetId, occurredAt])
  @@index([userId, occurredAt])
  @@index([productId, type, occurredAt])
}

// Заготовка тексту для копіювання. Channel це канал із журналу або 'any' для універсального.
// Редагує власник або адмін; кожна зміна змісту збільшує version.
model OutreachTemplate {
  id String @id @default(uuid())

  productId String
  ownerUserId String

  channel String
  title String
  subject String?
  body String
  version Int @default(1)

  status OutreachTemplateStatus @default(active)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  owner User @relation(fields: [ownerUserId], references: [id])
  events OutreachEvent[]

  @@index([productId, status, channel])
  @@index([ownerUserId])
}

enum ContentLocale {
  en
  es
  uk
}

enum ArticleStatus {
  draft
  published
  archived
}

// Зображення для статей. Файл лежить у S3-сумісному сховищі, тут лише метадані.
model MediaAsset {
  id String @id @default(uuid())

  key String @unique
  url String
  mime String @db.VarChar(40)
  size Int
  width Int
  height Int

  createdById String
  createdAt DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
  covers Article[]

  @@index([createdAt])
}

// Назви рубрик і тегів: { en: "...", es?: "...", uk?: "..." }, англійська обовʼязкова.
model ArticleCategory {
  id String @id @default(uuid())

  slug String @unique @db.VarChar(60)
  names Json
  sortOrder Int @default(0)

  articles Article[]
}

model ArticleTag {
  id String @id @default(uuid())

  slug String @unique @db.VarChar(60)
  names Json

  articles Article[]
}

// Стаття видима на сайті, коли status = published і publishedAt <= now (майбутня дата = планування).
// Вміст кожною мовою лежить у ArticleTranslation; англійська обовʼязкова.
model Article {
  id String @id @default(uuid())

  status ArticleStatus @default(draft)
  publishedAt DateTime?

  coverAssetId String?
  categoryId String?
  authorId String

  // Секретне посилання для перегляду чернетки без публікації.
  previewToken String @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cover MediaAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author User @relation(fields: [authorId], references: [id])
  tags ArticleTag[]
  translations ArticleTranslation[]

  @@index([status, publishedAt])
}

model ArticleTranslation {
  id String @id @default(uuid())

  articleId String
  locale ContentLocale

  slug String @db.VarChar(90)
  title String @db.VarChar(120)
  excerpt String @db.VarChar(300)
  seoTitle String? @db.VarChar(70)
  seoDescription String? @db.VarChar(170)
  keywords String[]
  coverAlt String? @db.VarChar(200)
  // Масив блоків: text, heading, image, video, quote, cta, product.
  blocks Json
  readingMinutes Int @default(1)
  // Завершений переклад (заголовок, анонс, хоча б один блок): лише такі віддаються публічно.
  isReady Boolean @default(false)

  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([locale, isReady])
}
