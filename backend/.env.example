FRONTEND_URL=FRONTEND_URL

JWT_SECRET=JWT_SECRET

DATABASE_URL=DATABASE_URL

STRIPE_SECRET=STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=STRIPE_WEBHOOK_SECRET
NOTIFICATIONS_SERVICE_URL=NOTIFICATIONS_SERVICE_URL
