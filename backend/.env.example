FRONTEND_URL=FRONTEND_URL

JWT_SECRET=JWT_SECRET

DATABASE_URL=DATABASE_URL

STRIPE_SECRET=STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=STRIPE_WEBHOOK_SECRET
NOTIFICATIONS_SERVICE_URL=NOTIFICATIONS_SERVICE_URL
NOTIFICATIONS_SERVICE_SECRET=NOTIFICATIONS_SERVICE_SECRET

# Frontend cache invalidation (optional): same secret on the Next.js side
REVALIDATE_SECRET=
FRONTEND_INTERNAL_URL=

# Article images: any S3-compatible storage (AWS S3, Cloudflare R2, MinIO). Uploads are disabled without these.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Non-AWS only (e.g. http://minio:9000 or the R2 endpoint)
S3_ENDPOINT=
S3_REGION=
# Public URL of the files (CDN or bucket), no trailing slash
S3_PUBLIC_URL=
