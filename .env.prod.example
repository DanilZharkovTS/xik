# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=xik_db
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@postgres:5432/xik_db

# Backend
PORT=5001
FRONTEND_URL=https://your-domain.com
JWT_SECRET=your_jwt_secret_key
SUBSCRIPTION_SERVICE_KEY=your_subscription_service_key
NOTIFICATIONS_SERVICE_URL=http://notifications:3002
NOTIFICATIONS_SERVICE_SECRET=your_notifications_secret
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Outreach ledger (all optional)
# Time zone for report day boundaries (IANA name)
REPORT_TIMEZONE=Europe/Kyiv
# Per-user limit for check/register/add-identifier requests per minute
OUTREACH_RATE_LIMIT=30
# Failed sign-in attempts per e-mail per 5 minutes
LOGIN_RATE_LIMIT=10

# Notifications Service
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev

# Frontend
NEXT_PUBLIC_API_URL=https://api.your-domain.com
# Internal backend address for server-side rendering (Docker network)
API_INTERNAL_URL=http://backend:5001
